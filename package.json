{
  "name": "@latheefwac/strapi-provider-upload-multi-cloud",
  "version": "1.0.2",
  "description": "Production-oriented Strapi 5 upload provider with unified AWS S3, Google Cloud Storage and Azure Blob Storage drivers, signed URLs, atomic collision-safe naming and HLS-aware storage.",
  "author": "Vinod",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "default": "./dist/storage.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepare": "npm run build",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "strapi",
    "strapi-provider",
    "strapi-provider-upload",
    "upload",
    "strapi5",
    "s3",
    "gcs",
    "azure",
    "multi-cloud",
    "hls"
  ],
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/lib-storage": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@azure/identity": "^4.14.1",
    "@azure/storage-blob": "^12.34.0",
    "@google-cloud/storage": "^8.4.0",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@strapi/strapi": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "aws-sdk-client-mock": "^4.1.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Latheefwac/strapi-provider-upload-multi-cloud.git"
  },
  "bugs": {
    "url": "https://github.com/Latheefwac/strapi-provider-upload-multi-cloud/issues"
  },
  "homepage": "https://github.com/Latheefwac/strapi-provider-upload-multi-cloud#readme",
  "publishConfig": {
    "access": "public"
  }
}
